  "scripts": {
    "version:node": "node -v",
    "version:npm": "npm -v",
    "version:pw": "npx playwright --version",
    "install-latest:node": "nvm install latest",
    "install-latest:npm": "npm install -g npm@latest",
    "install-latest:pw": "npm install -D @playwright/test@latest",
    "install-latest:pwDrivers": "npx playwright install",
    "regen": "npx playwright show-report",
    "erick": "echo Erick Jimenez",
    "test": "echo \"Error: no test specified\" && exit 1",
    "NOTREADYtestMapsServiceWithAllure": "npm run clean:allure && npx playwright test mapsServiceTest.spec.ts",
    "testLoadedProfile": "npx playwright test sep23.test.ts --headed --retries=0 --workers=2",
    "testMapsService": "npx playwright test testMapsApi",
    "testSwag": "npx playwright test testSwag",
    "testSwagAll": "npx playwright test testSwag",
    "testExcelDDT": "npx playwright test testSwagHooksOriginalAllInOne.test.ts --workers=8 --headed",
    "testDummyApi": "npx playwright test dummyApi.test.ts --workers=8",
    "testSep23": "npx playwright test sep23.test.ts --workers=8"
